  "derivation": {
    "near": "Authored sourceLOD2. All27,952combined foliage triangles retained exactly; onlywoodgeometry collapse-simplified. SourceCORNER/FLOAT_VECTOR UVMap restored to ordinary glTF2D UVs. Original sprig diffuse/alpha/GLnormal/roughness retained at1K. Sourcewoodmaterialnetworks consolidated using the common original bark PBR maps to retain two material draws per prototype.",
    "far": "Complete authored adult silhouettes CPU-baked at512px/view using unlit diffuse, view-relative normal and first-hit depth; packed into1024 four-view atlases. Two depth-shaped sheets and a900triangle connected3Dtrunk. No needle-geometry deletion is used to obtain opacity coverage.",
    "mirror": "C mirror applied directly to X vertex positions; polygon winding reversed before normal/tangent export; all exported node transforms have positive determinant.",
    "processing": "Blender4.5.9 LTS CPU only, two threads; no GPU rendering. Runtime images converted to8bits/channel. No directional illumination baked into baseColor.",
    "history": "Needle-collapse candidate rejected as empty stems. Sapling coverage candidate restored opacity but was rejected as immature/cactus-like. Both exact model/capture/header snapshots remain underbuild/fidelity-v1/rejected-needle-lod andcoverage-sapling-candidate."
  },
  "lodAdvisory": {
    "lod1": "Full authored3Dbough foliage for roadside/medium distance; original14m adult proportions.",
    "lod2": "Distant fixed-view impostor, advisory>50m. It is not a close-up hero mesh or dynamically view-blended LOD."
  },
